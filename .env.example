# GitHub personal access token (read-only, no scopes needed for public data).
# Used server-side only to fetch pinned repos via the GraphQL API.
GITHUB_TOKEN=

# Public URL of the deployed site (e.g. https://danielcastano.dev).
# Used for canonical URLs, Open Graph images, sitemap and robots.
# On Vercel it falls back to the production domain; otherwise localhost.
SITE_URL=
